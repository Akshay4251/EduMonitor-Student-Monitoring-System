# =====================================================================
# EduMonitor — Simple Firebase Configuration (.env)
# =====================================================================
# Copy this file to '.env' and enter your Firebase credentials.
# The app will automatically connect to your LIVE Firebase Cloud project!
# =====================================================================

# 1. Firebase Project Identifier
FIREBASE_PROJECT_ID=edumonitor-live
# 2. Firebase Web API Key (From Firebase Console > Project Settings > General)
FIREBASE_API_KEY=AIzaSyCjpm_04LqPLRoLumJpXxrjk2nZclPF_S8
FIREBASE_AUTH_DOMAIN=edumonitor-live.firebaseapp.com

# 3. Firebase Admin SDK (Choose Option A or Option B):
#
# Option A (Simplest): Place your downloaded service account JSON file in this directory:
FIREBASE_ADMIN_CREDENTIALS=firebase_admin_key.json
#
# Option B (Without any key file, paste values directly here):
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...-----END PRIVATE KEY-----\n"

# 4. Flask Secret Key (You can leave as is)
SECRET_KEY=edumonitor-super-secure-secret-key-32-chars-long!
