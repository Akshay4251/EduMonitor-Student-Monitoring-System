# =====================================================================
# EduMonitor — Environment Configuration Template
# =====================================================================
# The application runs immediately out of the box in zero-setup mode
# with real university courses, faculty, scholars, assignments, study
# materials, and live interactive sessions pre-seeded.
#
# To connect your own Google Firebase Cloud project, fill in the values
# below or simply place your 'firebase_admin_key.json' in the project root.
# =====================================================================

SECRET_KEY=edumonitor-super-secure-secret-key-32-chars-long!

# ── Google Cloud Firebase (Optional for Live Cloud Synchronization) ──
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app:
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_API_KEY=AIzaSy...your-web-api-key
# FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=123456789012
# FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ── Firebase Admin SDK (Optional alternative to key file) ────────────
# Path to service account JSON:
# FIREBASE_ADMIN_CREDENTIALS=firebase_admin_key.json
# Or raw service account JSON string (ideal for Docker / cloud deployments):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

