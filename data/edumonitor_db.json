  "materials:::mat-003": {
    "id": "mat-003",
    "classId": "class-se250",
    "className": "SE 250: Distributed Systems & Cloud-Native Infrastructure",
    "teacherId": "teacher-103",
    "teacherName": "Prof. Marcus Sterling",
    "title": "Systems Architecture: Raft Consensus Protocol & Fault-Tolerant State Machines",
    "type": "notes",
    "url": "",
    "youtubeId": "",
    "content": "Core Architectural Principles:\n1. Leader Election: Heartbeat timeouts (150-300ms) prevent split-brain elections.\n2. Log Replication: Entries committed once majority of cluster acknowledges.\n3. Safety: Leaders only commit entries from current term by counting replicas.\n4. Log Compaction: Snapshots discard obsolete transaction histories.\n\nKey Reference: Ongaro & Ousterhout (Stanford University, 2014).",
    "createdAt": "2026-11-05T10:54:04.692772+00:00"
  },
  "materials:::mat-004": {
    "id": "mat-004",
    "classId": "class-cy310",
    "className": "CY 310: Network Security & Applied Cryptography",
    "teacherId": "teacher-101",
    "teacherName": "Dr. Robert Anderson",
    "title": "Applied Cryptography Handbook: Modern Symmetric & Asymmetric Standards",
    "type": "notes",
    "url": "",
    "youtubeId": "",
    "content": "Cryptographic Selection Guidelines:\n- Symmetric Encryption: AES-256-GCM or ChaCha20-Poly1305 (Authenticated Encryption)\n- Key Exchange: ECDH using Curve25519 (X25519)\n- Digital Signatures: Ed25519 or ECDSA with P-256\n- Password Hashing: Argon2id (memory-hard, resistant to GPU attacks)\n- MACs: HMAC-SHA256 or BLAKE3",
    "createdAt": "2026-11-05T10:54:04.692772+00:00"
  },
